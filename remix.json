{
  "$schema": "node_modules/remix/schema/remix.json",
  "assets": {
    "rootDir": ".",
    "basePath": "/assets",
    "mounts": {
      "app": "app",
      "npm": "node_modules",
      "packages": "packages"
    },
    "allowFiles": ["app/routes.ts", "app/**/public/**"],
    "allowPackages": ["remix"],
    "denyFiles": ["app/**/*.test.*"]
  },
  "db": {
    "adapter": {
      "type": "sqlite",
      "filename": {
        "env": "DATABASE_URL",
        "default": "./db/tasklist.sqlite"
      },
      "foreignKeys": true
    },
    "migrations": {
      "directory": "./db/migrations"
    }
  }
}
