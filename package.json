{
  "name": "tasklist",
  "private": true,
  "type": "module",
  "scripts": {
    "remix": "remix",
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@remix-run/ui": "^0.11.0",
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "^0.70.0",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
